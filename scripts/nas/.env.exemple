# Copiez ce fichier en « .env » (dans le même dossier) puis remplissez-le.
# Le fichier .env contient des clés secrètes : il ne doit JAMAIS être envoyé sur GitHub ni partagé.

# Dossier du NAS où ranger la sauvegarde (chemin complet).
# Sous OpenMediaVault : Stockage → Dossiers partagés → colonne « Chemin absolu ».
DOSSIER_NAS=/srv/dev-disk-by-uuid-XXXX/Onde

# Identifiant du compte Cloudflare (tableau de bord → menu ⋯ à côté du nom du compte → « Copier l'ID du compte »).
CLOUDFLARE_ACCOUNT_ID=

# Clé R2 en LECTURE SEULE (R2 → Gérer les jetons d'API R2 → « Lecture d'objets uniquement », bucket onde-sons).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Jeton Cloudflare pour exporter la base D1 (Mon profil → Jetons d'API → Créer → permission Compte · D1 · Modifier).
CLOUDFLARE_API_TOKEN=

# Nom de la base D1 et du bucket R2 (normalement inchangés).
D1_NOM=Onde
R2_BUCKET=onde-sons
DEPOT_GIT=https://github.com/Sollaxxx/Onde.git
