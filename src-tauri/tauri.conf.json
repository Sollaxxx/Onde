{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Onde",
  "version": "0.2.2",
  "identifier": "app.onde.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Onde",
        "width": 1360,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "decorations": false,
        "dragDropEnabled": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#002FA7"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost https://pub-fd954b41e9a74a869ad359c2b577f7a3.r2.dev; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/Onde/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Video",
    "shortDescription": "Bruitages et musiques libres de droits pour monteurs",
    "copyright": "Onde — projet open-source (AGPL-3.0)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/samples/*",
      "resources/drag-icon.png"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4NzE2OTY5NzE0Q0ZCOTMKUldTVCsweHhhV2x4aUlxKzYvWFJucldzWXBLNVFoeXFrcWNwWUI1cWJqVzh1SUpXVjJTaGlyWGEK",
      "endpoints": [
        "https://github.com/sollaxxx/onde/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
